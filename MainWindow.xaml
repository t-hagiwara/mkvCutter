<Window x:Class="MkvCutter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKV Cutter"
        Width="760"
        Height="820"
        MinWidth="650"
        MinHeight="620"
        Icon="pack://application:,,,/assets/mkv-cutter_icon.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock FontSize="26" FontWeight="Bold" Text="MKV Cutter" />
            <TextBlock Margin="0,5,0,0" Foreground="#64748B"
                       Text="動画の開始・終了位置を指定して切り出します" />
        </StackPanel>

        <Border Grid.Row="1" Padding="18" Margin="0,0,0,14"
                Background="White" CornerRadius="10" AllowDrop="True"
                PreviewDragOver="Input_DragOver" PreviewDrop="Input_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,0,8" FontWeight="SemiBold"
                           Text="入力動画" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputPathTextBox" IsReadOnly="True"
                             Background="#F8FAFC" />
                    <Button Grid.Column="1" Margin="10,0,0,0" MinWidth="92"
                            Content="参照..." Click="BrowseInput_Click" />
                </Grid>
                <TextBlock Grid.Row="2" Margin="0,7,0,0" Foreground="#64748B"
                           FontSize="12"
                           Text="動画ファイルをここにドラッグ＆ドロップできます。" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="18" Margin="0,0,0,14"
                Background="White" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,0,12" FontWeight="SemiBold"
                           Text="切り出す範囲" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,8,0" Text="開始" />
                    <TextBox x:Name="StartTimeTextBox" Grid.Column="1"
                             Text="00:00:00.000" />
                    <TextBlock Grid.Column="2" Margin="18,0,8,0" Text="終了" />
                    <TextBox x:Name="EndTimeTextBox" Grid.Column="3"
                             Text="00:01:00.000" />
                </Grid>
                <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="#64748B"
                           FontSize="12"
                           Text="時:分:秒.ミリ秒（例 00:00:06.500）" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Padding="18" Margin="0,0,0,14"
                Background="White" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,0,8" FontWeight="SemiBold"
                           Text="保存先・出力ファイル" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputPathTextBox" />
                    <Button Grid.Column="1" Margin="10,0,0,0" MinWidth="92"
                            Content="保存先..." Click="BrowseOutput_Click" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock" Foreground="#475569"
                       Text="準備完了" />
            <Button x:Name="CancelButton" Grid.Column="1" Margin="8,0,0,0"
                    IsEnabled="False" Content="キャンセル"
                    Click="Cancel_Click" />
            <Button x:Name="StartButton" Grid.Column="2" Margin="8,0,0,0"
                    MinWidth="132" IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    FontWeight="SemiBold"
                    Click="Start_Click">
                <TextBlock Text="切り出し開始" Foreground="White" />
            </Button>
        </Grid>

        <Border Grid.Row="5" Padding="14" Background="#111827"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="#CBD5E1"
                           FontWeight="SemiBold" Text="実行ログ" />
                <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="#111827" Foreground="#E2E8F0"
                         BorderThickness="0" FontFamily="Consolas"
                         FontSize="12" />
            </Grid>
        </Border>

    </Grid>
</Window>
